<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include><uri>model://fire_extinguisher</uri><name>fire_extinguisher</name><pose>1.5 0 0 0 0 0</pose></include>
    <include><uri>model://first_aid_kit</uri><name>first_aid_kit</name><pose>-1.5 0 0 0 0 0</pose></include>

    <model name="yellow_sphere">
      <pose>0.25 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.5</radius></sphere></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_sphere">
      <pose>1.33 1.12 0.5 0 0 0</pose>
      <link name="link">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.5</radius></sphere></geometry><material><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="green_sphere">
      <pose>-2.69 2.5 0.5 0 0 0</pose>
      <link name="link">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.5</radius></sphere></geometry><material><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
    </model>

    <gui fullscreen="false">
      <camera name="user_camera"><pose>6.68 -6.89 6.07 0 0.55 2.11</pose><view_controller>orbit</view_controller></camera>
    </gui>
  </world>
</sdf>
